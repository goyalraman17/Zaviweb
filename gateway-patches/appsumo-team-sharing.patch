@@ -0,0 +1,41 @@
+package billing
+
+import (
+	"log/slog"
+	"testing"
+)
+
+func TestUsageOwnerUID(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		sub  UserSubscription
+		uid  string
+		want string
+	}{
+		{"team member", UserSubscription{PaymentPlatform: "appsumo", AppSumoTeamOwnerUID: "owner"}, "member", "owner"},
+		{"license owner", UserSubscription{PaymentPlatform: "appsumo", AppSumoTeamOwnerUID: "owner"}, "owner", "owner"},
+		{"legacy AppSumo account", UserSubscription{PaymentPlatform: "appsumo"}, "buyer", "buyer"},
+		{"unrelated plan", UserSubscription{PaymentPlatform: "razorpay", AppSumoTeamOwnerUID: "owner"}, "buyer", "buyer"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := tc.sub.UsageOwnerUID(tc.uid); got != tc.want {
+				t.Fatalf("UsageOwnerUID() = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestPendingWordsKeepOriginalTeamOwner(t *testing.T) {
+	tracker := NewUsageTracker(nil, nil, slog.Default())
+	tracker.usageOwners["member"] = "owner-a"
+	tracker.RecordWords("member", 12)
+	tracker.usageOwners["member"] = "owner-b"
+	tracker.RecordWords("member", 8)
+
+	if got := tracker.pendingCounts[usageBucket{uid: "member", ownerUID: "owner-a"}]; got != 12 {
+		t.Fatalf("original team's pending words = %d, want 12", got)
+	}
+	if got := tracker.pendingCounts[usageBucket{uid: "member", ownerUID: "owner-b"}]; got != 8 {
+		t.Fatalf("new team's pending words = %d, want 8", got)
+	}
+}
